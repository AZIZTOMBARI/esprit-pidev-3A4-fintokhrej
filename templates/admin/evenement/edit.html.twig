{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier l'événement - Admin{% endblock %}
{% block admin_page_title %}Événements{% endblock %}

{% block admin_content %}
<div class="admin-container" style="max-width: 700px; margin: 40px auto;">
    <div class="section-head">
        <h1 class="section-title">Modifier l'événement</h1>
    </div>

    <div style="background: white; padding: 30px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        {{ form_start(form) }}

        <div style="margin-bottom: 20px;">
            {{ form_label(form.titre) }}
            {{ form_widget(form.titre, {attr: {class: 'form-control'}}) }}
            {% if form.titre.vars.errors|length > 0 %}
                <div style="color: #c62828; font-size: 12px; margin-top: 5px;">
                    {% for error in form.titre.vars.errors %}
                        {{ error.message }}
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div style="margin-bottom: 20px;">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {attr: {class: 'form-control', rows: 5}}) }}
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
            <div>
                {{ form_label(form.dateDebut) }}
                {{ form_widget(form.dateDebut, {attr: {class: 'form-control', type: 'datetime-local'}}) }}
                {% if form.dateDebut.vars.errors|length > 0 %}
                    <div style="color: #c62828; font-size: 12px; margin-top: 5px;">
                        {% for error in form.dateDebut.vars.errors %}
                            {{ error.message }}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
            <div>
                {{ form_label(form.dateFin) }}
                {{ form_widget(form.dateFin, {attr: {class: 'form-control', type: 'datetime-local'}}) }}
                {% if form.dateFin.vars.errors|length > 0 %}
                    <div style="color: #c62828; font-size: 12px; margin-top: 5px;">
                        {% for error in form.dateFin.vars.errors %}
                            {{ error.message }}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
            <div>
                {{ form_label(form.capaciteMax) }}
                {{ form_widget(form.capaciteMax, {attr: {class: 'form-control'}}) }}
                {% if form.capaciteMax.vars.errors|length > 0 %}
                    <div style="color: #c62828; font-size: 12px; margin-top: 5px;">
                        {% for error in form.capaciteMax.vars.errors %}
                            {{ error.message }}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
            <div>
                {{ form_label(form.prix) }}
                {{ form_widget(form.prix, {attr: {class: 'form-control'}}) }}
                {% if form.prix.vars.errors|length > 0 %}
                    <div style="color: #c62828; font-size: 12px; margin-top: 5px;">
                        {% for error in form.prix.vars.errors %}
                            {{ error.message }}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
            <div>
                {{ form_label(form.statut) }}
                {{ form_widget(form.statut, {attr: {class: 'form-control'}}) }}
            </div>
            <div>
                {{ form_label(form.type) }}
                {{ form_widget(form.type, {attr: {class: 'form-control'}}) }}
            </div>
        </div>

        <div style="margin-bottom: 20px;">
            {{ form_label(form.lieu) }}
            {{ form_widget(form.lieu, {attr: {class: 'form-control'}}) }}
        </div>

        <div style="margin-bottom: 20px;">
            {{ form_label(form.imageFile) }}
            {{ form_widget(form.imageFile, {attr: {class: 'form-control'}}) }}
            {% if form.imageFile.vars.errors|length > 0 %}
                <div style="color: #c62828; font-size: 12px; margin-top: 5px;">
                    {% for error in form.imageFile.vars.errors %}
                        {{ error.message }}
                    {% endfor %}
                </div>
            {% endif %}
            <div style="font-size: 12px; color: #64748b; margin-top: 6px;">
                Formats acceptés: JPG, PNG, WEBP, GIF. Taille max: 4 Mo.
            </div>
        </div>

        <div style="margin-bottom: 30px;">
            {{ form_label(form.imageUrl) }}
            {{ form_widget(form.imageUrl, {attr: {class: 'form-control', placeholder: 'https://...'}}) }}
            {% if form.imageUrl.vars.errors|length > 0 %}
                <div style="color: #c62828; font-size: 12px; margin-top: 5px;">
                    {% for error in form.imageUrl.vars.errors %}
                        {{ error.message }}
                    {% endfor %}
                </div>
            {% endif %}
            <div style="font-size: 12px; color: #64748b; margin-top: 6px;">L'upload a la priorité sur l'URL si les deux sont fournis.</div>
        </div>

        <div style="display: flex; gap: 10px;">
            <button type="submit" class="cta-btn" style="flex: 1; padding: 12px;">Enregistrer les modifications</button>
            <a href="{{ path('app_admin_evenements') }}" class="outline-btn" style="flex: 1; padding: 12px; text-align: center; text-decoration: none;">Annuler</a>
        </div>

        {{ form_end(form) }}
    </div>
 </div>

<style>
    .form-control {
        display: block;
        width: 100%;
        padding: 8px 12px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
        font-family: inherit;
    }
    .form-control:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }
    label {
        display: block;
        margin-bottom: 5px;
        font-weight: 600;
        font-size: 14px;
        color: #333;
    }
</style>
{% endblock %}
