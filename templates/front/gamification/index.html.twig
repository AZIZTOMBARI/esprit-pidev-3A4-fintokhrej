{% extends 'front/base_front.html.twig' %}

{% block title %}Gamification | Fin Tokhroj{% endblock %}

{% block front_content %}
    {% set data = gamification %}
    {% set up = data.userPoints %}
    {% set level = data.level %}

    <section style="display:grid;gap:18px;">
        <div class="app-card" style="padding:24px;background:linear-gradient(135deg,#0d2137,#1a3a5c);color:#fff;border:1px solid rgba(79,195,247,.28);">
            <div style="display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap;align-items:flex-start;">
                <div style="display:grid;gap:10px;">
                    <div style="font-size:2.5rem;">{{ level.emoji }}</div>
                    <div style="font-size:1.5rem;font-weight:800;">{{ level.level }}</div>
                    <div style="font-size:2rem;font-weight:900;color:#ffd700;">{{ up.total_points|number_format(0, ',', ' ') }} pts</div>
                    <div style="color:rgba(255,255,255,.78);font-weight:700;">{{ data.rank > 0 ? 'Rang #' ~ data.rank : 'Non classe' }}</div>
                    <div style="color:#d7e7ff;">
                        {% if up.points_niveau_suivant > 0 %}
                            Encore {{ up.points_niveau_suivant }} pts pour le niveau suivant
                        {% else %}
                            Niveau maximum atteint
                        {% endif %}
                    </div>
                </div>

                <div style="display:grid;gap:10px;min-width:min(100%,340px);flex:1;">
                    <div style="height:14px;background:rgba(255,255,255,.12);border-radius:999px;overflow:hidden;">
                        <div style="height:100%;width:{{ (up.progression_niveau * 100)|round(0, 'floor') }}%;background:linear-gradient(90deg,#4fc3f7,#ffd700);border-radius:999px;transition:width .8s ease;"></div>
                    </div>
                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;">
                        <div style="padding:12px;border-radius:14px;background:rgba(255,255,255,.08);">
                            <div style="font-size:.8rem;color:#b8d2ea;">Lieux visites</div>
                            <div style="font-size:1.35rem;font-weight:800;">{{ up.nb_lieux_visites }}</div>
                        </div>
                        <div style="padding:12px;border-radius:14px;background:rgba(255,255,255,.08);">
                            <div style="font-size:.8rem;color:#b8d2ea;">Avis laisses</div>
                            <div style="font-size:1.35rem;font-weight:800;">{{ up.nb_avis_laisses }}</div>
                        </div>
                        <div style="padding:12px;border-radius:14px;background:rgba(255,255,255,.08);">
                            <div style="font-size:.8rem;color:#b8d2ea;">Favoris</div>
                            <div style="font-size:1.35rem;font-weight:800;">{{ up.nb_favoris }}</div>
                        </div>
                        <div style="padding:12px;border-radius:14px;background:rgba(255,255,255,.08);">
                            <div style="font-size:.8rem;color:#b8d2ea;">Sorties jointes</div>
                            <div style="font-size:1.35rem;font-weight:800;">{{ up.nb_sorties_jointes }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div style="display:grid;grid-template-columns:minmax(0,1.4fr) minmax(320px,.9fr);gap:18px;align-items:start;">
            <section class="app-card" style="padding:22px;">
                <div class="section-head" style="margin-bottom:14px;">
                    <div>
                        <h2 class="section-title" style="margin:0;">Mes badges</h2>
                        <p class="section-subtitle" style="margin-top:6px;">{{ data.badges|length }} / {{ data.allBadges|length }} badges obtenus</p>
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;">
                    {% set ownedCodes = {} %}
                    {% for badge in data.badges %}
                        {% set ownedCodes = ownedCodes|merge({ (badge.code): true }) %}
                    {% endfor %}

                    {% for badge in data.allBadges %}
                        {% set owned = ownedCodes[badge.code]|default(false) %}
                        <article title="{{ badge.description }}{% if badge.points_bonus > 0 %} | +{{ badge.points_bonus }} pts bonus{% endif %}"
                                 style="display:grid;gap:6px;justify-items:center;padding:14px;border-radius:16px;border:1.5px solid {{ owned ? 'rgba(79,195,247,.45)' : 'rgba(44,62,80,.65)' }};background:{{ owned ? 'linear-gradient(180deg,#1e2a3a,#132031)' : '#151d27' }};opacity:{{ owned ? '1' : '.42' }};text-align:center;">
                            <div style="font-size:1.9rem;">{{ badge.emoji ?: '🏅' }}</div>
                            <div style="font-size:.9rem;font-weight:800;color:#fff;">{{ badge.nom }}</div>
                            <div style="font-size:.76rem;color:#90a4ae;">{{ badge.description }}</div>
                            <div style="font-size:.72rem;font-weight:800;color:{{ owned ? '#4fc3f7' : '#6f8293' }};">
                                {{ owned ? 'Obtenu' : '+' ~ badge.seuil_requis ~ ' actions' }}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </section>

            <section class="app-card" style="padding:22px;">
                <div class="section-head" style="margin-bottom:14px;">
                    <div>
                        <h2 class="section-title" style="margin:0;">Mes offres badges</h2>
                        <p class="section-subtitle" style="margin-top:6px;">Recompenses actives debloquees par tes badges</p>
                    </div>
                </div>

                {% if data.offers is empty %}
                    <div style="padding:16px;border:1px dashed rgba(20,61,113,.16);border-radius:16px;color:var(--ft-muted);">
                        Aucune offre active pour le moment. Gagne des badges pour debloquer des reductions.
                    </div>
                {% else %}
                    <div style="display:grid;gap:12px;">
                        {% for offer in data.offers %}
                            <article style="display:grid;grid-template-columns:72px 1fr 90px;gap:14px;align-items:center;padding:16px;border-radius:16px;background:linear-gradient(135deg,#0d2137,#0d2b0d);border:1.5px solid rgba(46,125,50,.4);color:#fff;">
                                <div style="text-align:center;">
                                    <div style="font-size:1.8rem;font-weight:900;color:#66bb6a;">-{{ offer.pourcentage|round(0, 'floor') }}%</div>
                                    <div style="font-size:.66rem;font-weight:800;color:#2e7d32;">REDUCTION</div>
                                </div>
                                <div style="display:grid;gap:4px;">
                                    <div style="font-weight:800;">🎁 {{ offer.titre }}</div>
                                    <div style="font-size:.8rem;color:#b0bec5;">{{ offer.description ?: 'Valable sur les lieux partenaires.' }}</div>
                                    <div style="font-size:.78rem;color:#66bb6a;">Badge: {{ offer.badge_code }}</div>
                                </div>
                                <div style="text-align:right;">
                                    <div style="font-size:1.5rem;font-weight:900;color:{{ offer.jours_restants <= 2 ? '#ff5252' : (offer.jours_restants <= 5 ? '#ffd740' : '#66bb6a') }};">{{ offer.jours_restants }}j</div>
                                    <div style="font-size:.7rem;color:#90a4ae;">restants</div>
                                    <div style="font-size:.72rem;color:#78909c;margin-top:4px;">Expire le {{ offer.date_fin|date('d/m/Y') }}</div>
                                </div>
                            </article>
                        {% endfor %}
                    </div>
                {% endif %}
            </section>
        </div>

        <section class="app-card" style="padding:22px;">
            <div class="section-head" style="margin-bottom:14px;">
                <div>
                    <h2 class="section-title" style="margin:0;">Classement local</h2>
                    <p class="section-subtitle" style="margin-top:6px;">Top 20 des utilisateurs les plus actifs</p>
                </div>
            </div>

            <div style="display:grid;gap:10px;">
                {% for row in data.leaderboard %}
                    {% set isMe = app.user and row.user_id == app.user.id %}
                    <article style="display:grid;grid-template-columns:56px 44px 1fr auto;gap:12px;align-items:center;padding:12px 14px;border-radius:12px;background:{{ isMe ? '#1a3a5c' : (loop.index is even ? '#111920' : '#0e151c') }};border:1.5px solid {{ isMe ? '#4fc3f7' : 'transparent' }};">
                        <div style="font-size:1.1rem;font-weight:800;color:#fff;">{{ row.rang_emoji }}</div>
                        <div style="width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:{{ isMe ? '#1565c0' : '#1e2a3a' }};border:1.5px solid {{ isMe ? '#4fc3f7' : '#2c3e50' }};color:#fff;font-weight:800;">
                            {{ row.prenom ? row.prenom|slice(0,1)|upper : '?' }}
                        </div>
                        <div>
                            <div style="font-weight:800;color:{{ isMe ? '#4fc3f7' : '#fff' }};">{{ row.nom_complet ?: 'Utilisateur' }}{% if isMe %} (Vous){% endif %}</div>
                            <div style="font-size:.8rem;color:#90a4ae;">{{ row.niveau_emoji }} {{ row.niveau }} • {{ row.nb_badges }} badges</div>
                        </div>
                        <div style="font-weight:900;color:#ffd700;">{{ row.total_points|number_format(0, ',', ' ') }} pts</div>
                    </article>
                {% else %}
                    <div style="color:var(--ft-muted);">Aucun classement disponible pour le moment.</div>
                {% endfor %}
            </div>
        </section>
    </section>
{% endblock %}
