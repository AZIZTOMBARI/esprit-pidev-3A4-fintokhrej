{% extends 'front/base_front.html.twig' %}

{% block title %}Offres | Fin Tokhroj{% endblock %}

{% block front_content %}
<section>
    <div class="section-head">
        <div>
            <h1 class="section-title">Offres</h1>
            <p class="section-subtitle">Offres actives avec filtre par lieu et indicateur d'urgence.</p>
        </div>
        <a href="{{ path('app_home') }}" class="outline-btn">Retour accueil</a>
    </div>

    <form method="get" action="{{ path('app_offres') }}" style="margin-bottom: 14px; display:flex; gap:8px; flex-wrap:wrap; align-items:end;">
        <div>
            <label for="lieu" style="display:block; font-weight:600; margin-bottom:4px;">Filtrer par lieu</label>
            <select id="lieu" name="lieu" style="border:1px solid #cbd5e1; border-radius:10px; padding:10px 12px; min-width:240px;">
                <option value="0">Tous les lieux</option>
                {% for lieu in lieux %}
                    <option value="{{ lieu.id }}" {{ selectedLieu == lieu.id ? 'selected' : '' }}>{{ lieu.nom }}</option>
                {% endfor %}
            </select>
        </div>
        <button class="outline-btn" type="submit">Appliquer</button>
    </form>

    <div class="listing-grid">
        {% for item in offres %}
            <article class="listing-card">
                <div class="cover-thumb"><span>{{ attribute(item, 'titre') }}</span></div>
                <div class="listing-card__top">
                    <div>
                        <h3>{{ attribute(item, 'titre') }}</h3>
                        <p>
                            {% if item.type is defined and item.type %}{{ item.type }}{% endif %}
                            {% if item.pourcentage is defined and item.pourcentage %} · {{ item.pourcentage }}{% endif %}
                        </p>
                    </div>
                    {% if item.prix is defined %}<span class="price-pill">{{ item.prix }} TND</span>{% endif %}
                    {% if item.pourcentage is defined %}<span class="price-pill">{{ item.pourcentage }}%</span>{% endif %}
                    {% if item.expiring_soon is defined and item.expiring_soon %}<span class="price-pill" style="background:#fee2e2; color:#991b1b;">Expire bientôt</span>{% endif %}
                </div>
                <div class="meta-row">
                    {% if item.lieu_nom is defined and item.lieu_nom %}<span>📍 {{ item.lieu_nom }}{% if item.ville is defined and item.ville %}, {{ item.ville }}{% endif %}</span>{% endif %}
                    {% if item.date_sortie is defined %}<span>🗓 {{ item.date_sortie|date('d/m/Y H:i') }}</span>{% endif %}
                    {% if item.date_debut is defined %}<span>🗓 {{ item.date_debut|date('d/m/Y H:i') }}</span>{% endif %}
                    {% if item.date_fin is defined %}<span>⏳ {{ item.date_fin|date('d/m/Y') }}</span>{% endif %}
                    {% if item.budget_min is defined %}<span>💸 {{ item.budget_min ?? 0 }} - {{ item.budget_max ?? 0 }} TND</span>{% endif %}
                    {% if item.nb_places is defined %}<span>👥 {{ item.nb_places }} places</span>{% endif %}
                    {% if item.statut is defined %}<span>✅ {{ item.statut }}</span>{% endif %}
                </div>
                {% if item.description is defined and item.description %}
                    <p style="margin-top:14px;">{{ item.description }}</p>
                {% endif %}

                <div style="margin-top: 14px;">
                    <a href="{{ path('app_offres_show', {id: item.id}) }}" class="outline-btn">Voir détails</a>
                </div>
            </article>
        {% else %}
            <div class="empty-state">Aucune donnée disponible pour cette page.</div>
        {% endfor %}
    </div>
</section>
{% endblock %}