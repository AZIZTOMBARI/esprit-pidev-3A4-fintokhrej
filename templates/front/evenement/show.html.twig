{% extends 'front/base_front.html.twig' %}

{% block title %}{{ event.titre }} | Fin Tokhroj{% endblock %}

{% block front_content %}
<section style="max-width: 900px; margin: 30px auto; padding: 0 20px;">
    <!-- En-tête avec image -->
    <div style="background: #f5f5f5; border-radius: 8px; overflow: hidden; marginBottom: 30px;">
        {% set rawImage = event.imageUrl|default('') %}
        {% if rawImage and (rawImage starts with 'http://' or rawImage starts with 'https://') %}
            {% set imageSrc = rawImage %}
        {% elseif rawImage and (rawImage starts with 'theme/' or rawImage starts with 'uploads/') %}
            {% set imageSrc = asset(rawImage) %}
        {% elseif rawImage %}
            {% set imageSrc = asset('uploads/evenements/' ~ rawImage) %}
        {% else %}
            {% set imageSrc = '' %}
        {% endif %}

        {% if imageSrc %}
            <img src="{{ imageSrc }}" alt="{{ event.titre }}" style="width: 100%; height: 400px; object-fit: cover; display: block;" onerror="this.onerror=null;this.src='{{ asset('theme/images/logo.png') }}';">
        {% else %}
            <div style="width: 100%; height: 400px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 120px; font-weight: bold;">
                {{ event.titre|slice(0,1) }}
            </div>
        {% endif %}
    </div>

    <!-- Informations principales -->
    <div style="background: white; padding: 30px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 20px;">
            <div>
                <h1 style="margin: 0 0 10px 0; font-size: 28px;">{{ event.titre }}</h1>
                <p style="margin: 5px 0; color: #666; font-size: 14px;">
                    📍 {{ event.lieu ? event.lieu.nom : 'Lieu à confirmer' }} 
                    {% if event.lieu %}
                        • {{ event.lieu.ville }}
                    {% endif %}
                </p>
            </div>
            {% if event.prix > 0 %}
                <span style="background: #667eea; color: white; padding: 10px 20px; border-radius: 20px; font-size: 18px; font-weight: bold;">
                    {{ event.prix }} TND
                </span>
            {% else %}
                <span style="background: #4CAF50; color: white; padding: 10px 20px; border-radius: 20px; font-size: 18px; font-weight: bold;">
                    GRATUIT
                </span>
            {% endif %}
        </div>

        <!-- Détails date/heure -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 1px solid #eee;">
            <div>
                <h4 style="margin: 0 0 8px 0; color: #667eea; font-size: 12px; text-transform: uppercase;">Début</h4>
                <p style="margin: 0; font-size: 16px;">
                    <strong>{{ event.dateDebut|date('d/m/Y') }}</strong><br>
                    à <strong>{{ event.dateDebut|date('H:i') }}</strong>
                </p>
            </div>
            <div>
                <h4 style="margin: 0 0 8px 0; color: #667eea; font-size: 12px; text-transform: uppercase;">Fin</h4>
                <p style="margin: 0; font-size: 16px;">
                    <strong>{{ event.dateFin|date('d/m/Y') }}</strong><br>
                    à <strong>{{ event.dateFin|date('H:i') }}</strong>
                </p>
            </div>
        </div>

        <!-- Places restantes -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px;">
            <div>
                <h4 style="margin: 0 0 8px 0; color: #667eea; font-size: 12px; text-transform: uppercase;">Capacité</h4>
                <p style="margin: 0; font-size: 16px;">
                    <strong>{{ event.capaciteMax }} places</strong>
                </p>
            </div>
            <div>
                <h4 style="margin: 0 0 8px 0; color: #667eea; font-size: 12px; text-transform: uppercase;">Places restantes</h4>
                <p style="margin: 0; font-size: 16px;">
                    <strong style="color: {% if event.placesRestantes > 0 %}#4CAF50{% else %}#f44336{% endif %};">
                        {{ event.placesRestantes }} places
                    </strong>
                </p>
            </div>
        </div>

        <!-- Statut et type -->
        <div style="display: flex; gap: 10px; margin-bottom: 30px;">
            <span style="background: {% if event.statut == 'OUVERT' %}#4CAF50{% else %}#f44336{% endif %}; color: white; padding: 8px 15px; border-radius: 20px; font-size: 12px; font-weight: bold;">
                {{ event.statut }}
            </span>
            <span style="background: {% if event.type == 'PUBLIC' %}#2196F3{% else %}#FF9800{% endif %}; color: white; padding: 8px 15px; border-radius: 20px; font-size: 12px; font-weight: bold;">
                {{ event.type }}
            </span>
        </div>

        <!-- Description -->
        {% if event.description %}
            <div style="margin-bottom: 30px;">
                <h3 style="margin: 0 0 15px 0; font-size: 18px;">Description</h3>
                <p style="margin: 0; line-height: 1.6; color: #555;">
                    {{ event.description }}
                </p>
            </div>
        {% endif %}

        <!-- Bouton d'inscription -->
        {% if app.user %}
            {% set userAlreadyRegistered = false %}
            {% for inscription in event.inscriptions %}
                {% if inscription.user.id == app.user.id and inscription.statut not in ['ANNULEE', 'REJETEE'] %}
                    {% set userAlreadyRegistered = true %}
                {% endif %}
            {% endfor %}

            {% if event.placesRestantes > 0 and not userAlreadyRegistered %}
                <a href="{{ path('app_evenement_inscrire_form', {id: event.id}) }}" class="cta-btn" style="margin-top: 30px; display: block; text-align: center; padding: 15px;">
                    🎟 Choisir le nombre de tickets
                </a>
            {% elseif userAlreadyRegistered %}
                <div style="margin-top: 30px; padding: 15px; background: #e3f2fd; border: 1px solid #2196F3; border-radius: 8px; color: #1976D2; font-weight: bold; text-align: center;">
                    ✓ Vous êtes déjà inscrit à cet événement
                    {% if mon_inscription %}
                        <div style="margin-top: 8px; font-weight: 600;">
                            Statut: {{ mon_inscription|replace({'_':' '}) }}
                        </div>
                    {% endif %}
                    <div style="margin-top: 10px;">
                        <a href="{{ path('app_mon_profil_inscriptions') }}" style="color: #1976D2; text-decoration: underline;">Voir mes inscriptions</a>
                    </div>
                </div>
            {% else %}
                <div style="margin-top: 30px; padding: 15px; background: #ffebee; border: 1px solid #f44336; border-radius: 8px; color: #c62828; font-weight: bold; text-align: center;">
                    Événement complet - Plus de places disponibles
                </div>
            {% endif %}
        {% else %}
            <div style="margin-top: 30px; padding: 15px; background: #fff3cd; border: 1px solid #ffc107; border-radius: 8px; color: #856404; font-weight: bold; text-align: center;">
                <a href="{{ path('app_login') }}" style="color: #856404; text-decoration: underline;">Connectez-vous</a> pour vous inscrire à cet événement
            </div>
        {% endif %}

        <!-- Lien retour -->
        <div style="margin-top: 30px; text-align: center;">
            <a href="{{ path('app_evenements') }}" style="color: #667eea; text-decoration: none; font-weight: bold;">
                ← Retour à la liste
            </a>
        </div>
    </div>
</section>

{% endblock %}
