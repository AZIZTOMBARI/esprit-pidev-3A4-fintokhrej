{% extends 'front/base_front.html.twig' %}

{% block title %}Paiement | {{ inscription.evenement.titre }}{% endblock %}

{% block front_content %}
<section style="max-width: 900px; margin: 30px auto; padding: 0 20px;">
    <div style="background: white; padding: 28px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
        <div style="display: flex; justify-content: space-between; align-items: start; gap: 12px; margin-bottom: 20px;">
            <div>
                <h1 style="margin: 0 0 8px 0; font-size: 24px;">Paiement</h1>
                <p style="margin: 0; color: #666;">{{ inscription.evenement.titre }}</p>
            </div>
            <span style="background: #e0f2fe; color: #075985; padding: 8px 12px; border-radius: 999px; font-weight: 600; font-size: 13px;">
                {{ inscription.nbTickets }} ticket{{ inscription.nbTickets > 1 ? 's' : '' }}
            </span>
        </div>

        <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 20px;">
            <div>
                <h3 style="margin: 0 0 12px 0; font-size: 16px;">Recapitulatif</h3>
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px;">
                    <p style="margin: 0 0 6px 0;">Date: <strong>{{ inscription.evenement.dateDebut|date('d/m/Y H:i') }}</strong></p>
                    <p style="margin: 0 0 6px 0;">Lieu: <strong>{{ inscription.evenement.lieu ? inscription.evenement.lieu.nom : 'Lieu a confirmer' }}</strong></p>
                    <p style="margin: 0 0 6px 0;">Prix unitaire: <strong>{% if inscription.evenement.prix > 0 %}{{ inscription.evenement.prix }} TND{% else %}Gratuit{% endif %}</strong></p>
                    <p style="margin: 0;">Montant total: <strong>{{ montant }} TND</strong></p>
                </div>
            </div>

            <div>
                <form method="POST" action="{{ path('app_inscription_paiement', {id: inscription.id}) }}">
                    <label style="display: block; margin-bottom: 6px; font-weight: 600;">Methode de paiement</label>
                    <div style="display: grid; gap: 8px; margin-bottom: 12px;">
                        {% for code, label in methodes %}
                            <label style="display: flex; align-items: center; gap: 8px;">
                                <input type="radio" name="methode" value="{{ code }}" {% if loop.first %}checked{% endif %}>
                                <span>{{ label }}</span>
                            </label>
                        {% endfor %}
                    </div>

                    <div id="card_fields" style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 8px; margin-bottom: 14px;">
                        <div style="font-size: 13px; font-weight: 600; margin-bottom: 6px;">Informations carte (simulation)</div>
                        <input type="text" name="nom_carte" class="form-control" placeholder="Nom sur la carte" style="margin-bottom: 8px;">
                        <input type="text" name="quatre_derniers" class="form-control" placeholder="4 derniers chiffres" maxlength="4">
                    </div>

                    <button type="submit" class="cta-btn" style="width: 100%; padding: 14px; font-weight: 700;">Payer</button>
                </form>
            </div>
        </div>

        <div style="margin-top: 20px; text-align: center;">
            <a href="{{ path('app_mon_profil_inscriptions') }}" style="color: #667eea; text-decoration: none; font-weight: 600;">Retour a mes inscriptions</a>
        </div>
    </div>
</section>

<script>
    const methodInputs = document.querySelectorAll('input[name="methode"]');
    const cardFields = document.getElementById('card_fields');

    const toggleCardFields = () => {
        const selected = document.querySelector('input[name="methode"]:checked');
        const isCard = selected && selected.value === '{{ constant('App\\Entity\\Paiement::METHODE_CARTE') }}';
        if (cardFields) {
            cardFields.style.display = isCard ? 'block' : 'none';
        }
    };

    methodInputs.forEach((input) => input.addEventListener('change', toggleCardFields));
    toggleCardFields();
</script>
{% endblock %}
