{% extends 'front/base_front.html.twig' %}

{% block title %}Tickets | {{ inscription.evenement.titre }}{% endblock %}

{% block front_content %}
<section style="max-width: 900px; margin: 30px auto; padding: 0 20px;">
    <div style="background: white; padding: 28px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
        <div style="display: flex; justify-content: space-between; align-items: start; gap: 12px; margin-bottom: 20px;">
            <div>
                <h1 style="margin: 0 0 8px 0; font-size: 24px;">Vos tickets</h1>
                <p style="margin: 0; color: #666;">{{ inscription.evenement.titre }}</p>
            </div>
            <span style="background: #dcfce7; color: #166534; padding: 8px 12px; border-radius: 999px; font-weight: 600; font-size: 13px;">Paiement confirme</span>
        </div>

        <div style="display: grid; gap: 12px;">
            {% for ticket in tickets %}
                <div style="border: 1px dashed #cbd5f5; padding: 14px; border-radius: 10px; background: #f8fafc;">
                    <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px;">
                        <div>
                            <div style="font-weight: 700;">{{ ticket.getNumeroTicketFinal() }}</div>
                            <div style="font-size: 13px; color: #64748b;">Emis le {{ ticket.date|date('d/m/Y') }}</div>
                        </div>
                        <div style="text-align: right;">
                            <div style="font-size: 12px; color: #64748b;">Code validation</div>
                            <div style="font-weight: 700;">{{ ticket.codeValidation }}</div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="empty-state">Aucun ticket genere.</div>
            {% endfor %}
        </div>

        <div style="margin-top: 20px; text-align: center;">
            <a href="{{ path('app_mon_profil_inscriptions') }}" style="color: #667eea; text-decoration: none; font-weight: 600;">Retour a mes inscriptions</a>
        </div>
    </div>
</section>
{% endblock %}
