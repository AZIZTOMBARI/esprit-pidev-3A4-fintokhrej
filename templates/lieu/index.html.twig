{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des lieux | Fin Tokhroj{% endblock %}
{% block admin_page_title %}Gestion des lieux{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('admin/lieu/_styles.html.twig') }}
{% endblock %}

{% block admin_content %}
    {{ include('admin/lieu/_flashes.html.twig') }}

    <div class="section-head">
        <div>
            <h2 class="section-title">Gestion des lieux</h2>
            <p class="section-subtitle">Créer, consulter, filtrer, trier et supprimer les lieux depuis l'espace admin.</p>
        </div>
        <div class="lieu-page-actions">
            <a href="{{ path('app_admin_lieu_new') }}" class="primary-btn">Nouveau lieu</a>
            <a href="{{ path('app_admin_dashboard') }}" class="secondary-btn">Retour dashboard</a>
        </div>
    </div>

    <div class="lieu-search-card">
        <form method="get" action="{{ path('app_admin_lieu_index') }}" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold">Recherche</label>
                <input type="text" name="q" value="{{ searchQuery }}" class="form-control" placeholder="Nom ou ville">
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Catégorie</label>
                <select name="categorie" class="form-select">
                    <option value="">Toutes les catégories</option>
                    {% for categorie in categorieCases %}
                        <option value="{{ categorie.value }}" {{ currentCategorie == categorie.value ? 'selected' : '' }}>{{ categorie.label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Type</label>
                <select name="type" class="form-select">
                    <option value="">Tous les types</option>
                    {% for type in typeCases %}
                        <option value="{{ type.value }}" {{ currentType == type.value ? 'selected' : '' }}>{{ type.label }}</option>
                    {% endfor %}
                </select>
            </div>
            <input type="hidden" name="sort" value="{{ currentSort }}">
            <input type="hidden" name="dir" value="{{ currentDirection }}">
            <div class="col-md-2">
                <button type="submit" class="primary-btn w-100">Filtrer</button>
            </div>
        </form>
        <div class="lieu-search-actions">
            <a href="{{ path('app_admin_lieu_index') }}" class="secondary-btn">Réinitialiser</a>
            <span class="text-muted">{{ totalItems }} lieu(x) trouvé(s)</span>
        </div>
    </div>

    <div class="lieu-card table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    {% set baseQuery = app.request.query.all|merge({'page': 1}) %}
                    {% set nextIdDir = currentSort == 'id' and currentDirection == 'ASC' ? 'DESC' : 'ASC' %}
                    {% set nextNomDir = currentSort == 'nom' and currentDirection == 'ASC' ? 'DESC' : 'ASC' %}
                    {% set nextVilleDir = currentSort == 'ville' and currentDirection == 'ASC' ? 'DESC' : 'ASC' %}
                    {% set nextCategorieDir = currentSort == 'categorie' and currentDirection == 'ASC' ? 'DESC' : 'ASC' %}
                    {% set nextTypeDir = currentSort == 'type' and currentDirection == 'ASC' ? 'DESC' : 'ASC' %}
                    {% set nextBudgetDir = currentSort == 'budget' and currentDirection == 'ASC' ? 'DESC' : 'ASC' %}
                    <th><a class="lieu-sort-link" href="{{ path('app_admin_lieu_index', baseQuery|merge({'sort': 'id', 'dir': nextIdDir})) }}">ID</a></th>
                    <th><a class="lieu-sort-link" href="{{ path('app_admin_lieu_index', baseQuery|merge({'sort': 'nom', 'dir': nextNomDir})) }}">Nom</a></th>
                    <th><a class="lieu-sort-link" href="{{ path('app_admin_lieu_index', baseQuery|merge({'sort': 'ville', 'dir': nextVilleDir})) }}">Ville</a></th>
                    <th><a class="lieu-sort-link" href="{{ path('app_admin_lieu_index', baseQuery|merge({'sort': 'categorie', 'dir': nextCategorieDir})) }}">Catégorie</a></th>
                    <th><a class="lieu-sort-link" href="{{ path('app_admin_lieu_index', baseQuery|merge({'sort': 'type', 'dir': nextTypeDir})) }}">Type</a></th>
                    <th><a class="lieu-sort-link" href="{{ path('app_admin_lieu_index', baseQuery|merge({'sort': 'budget', 'dir': nextBudgetDir})) }}">Budget</a></th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for lieu in lieux %}
                    {% set categoryValue = lieu.categorie ? lieu.categorie.value : '' %}
                    {% set categoryClassMap = {
                        'CAFE': 'bg-warning text-dark',
                        'RESTO': 'bg-danger',
                        'RESTO_BAR': 'bg-dark',
                        'LIEU_PUBLIC': 'bg-primary',
                        'PARC_ATTRACTION': 'bg-success',
                        'MUSEE': 'bg-info text-dark',
                        'PLAGE': 'bg-info text-dark',
                        'CENTRE_COMMERCIAL': 'bg-secondary'
                    } %}
                    {% set categoryClass = categoryClassMap[categoryValue]|default('bg-primary') %}
                    <tr>
                        <td>{{ lieu.id }}</td>
                        <td class="fw-semibold">{{ lieu.nom }}</td>
                        <td>{{ lieu.ville }}</td>
                        <td><span class="badge {{ categoryClass }}">{{ lieu.categorie ? lieu.categorie.label : '—' }}</span></td>
                        <td>
                            {% if lieu.type %}
                                {% if lieu.type.value == 'PUBLIC' %}
                                    <span class="badge bg-success">{{ lieu.type.label }}</span>
                                {% else %}
                                    <span class="badge bg-warning text-dark">{{ lieu.type.label }}</span>
                                {% endif %}
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        <td>
                            {% if lieu.budgetMin is not null or lieu.budgetMax is not null %}
                                {{ lieu.budgetMin is not null ? lieu.budgetMin|number_format(2, ',', ' ') : '—' }}
                                —
                                {{ lieu.budgetMax is not null ? lieu.budgetMax|number_format(2, ',', ' ') : '—' }}
                                TND
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a href="{{ path('app_admin_lieu_show', {id: lieu.id}) }}" class="btn btn-light btn-sm border">Voir</a>
                                <a href="{{ path('app_admin_lieu_edit', {id: lieu.id}) }}" class="btn btn-primary btn-sm">Modifier</a>
                                <form method="post" action="{{ path('app_admin_lieu_delete', {id: lieu.id}) }}" onsubmit="return confirm('Supprimer ce lieu ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_lieu_' ~ lieu.id) }}">
                                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7">
                            <div class="lieu-empty-state">
                                {% if searchQuery or currentCategorie or currentType %}
                                    Aucun lieu ne correspond aux filtres actifs.
                                {% else %}
                                    Aucun lieu enregistré.
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if pageCount > 1 %}
        <nav class="lieu-pagination" aria-label="Pagination des lieux">
            <ul class="pagination mb-0">
                <li class="page-item {{ page <= 1 ? 'disabled' : '' }}">
                    <a class="page-link" href="{{ page > 1 ? path('app_admin_lieu_index', app.request.query.all|merge({'page': page - 1})) : '#' }}">Précédent</a>
                </li>
                {% for currentPage in 1..pageCount %}
                    <li class="page-item {{ currentPage == page ? 'active' : '' }}">
                        <a class="page-link" href="{{ path('app_admin_lieu_index', app.request.query.all|merge({'page': currentPage})) }}">{{ currentPage }}</a>
                    </li>
                {% endfor %}
                <li class="page-item {{ page >= pageCount ? 'disabled' : '' }}">
                    <a class="page-link" href="{{ page < pageCount ? path('app_admin_lieu_index', app.request.query.all|merge({'page': page + 1})) : '#' }}">Suivant</a>
                </li>
            </ul>
        </nav>
    {% endif %}
{% endblock %}
