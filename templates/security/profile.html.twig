{% extends 'front/base_front.html.twig' %}

{% block title %}Mon profil | Fin Tokhroj{% endblock %}

{% block front_content %}
    <section class="app-card" style="padding:24px;">
        <div class="section-head" style="margin-bottom:14px;">
            <div>
                <h2 class="section-title" style="margin:0;">Modifier mon compte</h2>
                <p class="section-subtitle" style="margin-top:6px;">Mets a jour tes informations personnelles.</p>
            </div>
            <a href="{{ path('app_gamification_dashboard') }}" class="outline-btn" style="text-decoration:none;display:inline-flex;align-items:center;">Voir ma gamification</a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="sortie-flash sortie-flash-success">{{ message }}</div>
        {% endfor %}

        {% set profileRawImage = app.user ? (app.user.imageUrl|default('')) : '' %}
        {% if profileRawImage and (profileRawImage starts with 'http://' or profileRawImage starts with 'https://') %}
            {% set profileImageSrc = profileRawImage %}
        {% elseif profileRawImage and (profileRawImage starts with 'theme/' or profileRawImage starts with 'uploads/') %}
            {% set profileImageSrc = asset(profileRawImage) %}
        {% elseif profileRawImage and profileRawImage != 'default.png' %}
            {% set profileImageSrc = asset('uploads/users/' ~ profileRawImage) %}
        {% else %}
            {% set profileImageSrc = asset('theme/images/logo.png') %}
        {% endif %}

        <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px;padding:12px;border:1px solid rgba(20,61,113,.1);border-radius:16px;background:rgba(255,255,255,.75);">
            <img src="{{ profileImageSrc }}" alt="photo profil" style="width:56px;height:56px;border-radius:14px;object-fit:cover;" onerror="this.onerror=null;this.src='{{ asset('theme/images/logo.png') }}';">
            <div>
                <div style="font-weight:800;color:var(--ft-text);">{{ app.user.prenom|default('') }} {{ app.user.nom|default('') }}</div>
                <div style="font-size:.82rem;color:var(--ft-muted);">{{ app.user.email|default('') }}</div>
            </div>
        </div>

        {{ form_start(form, {attr: {class: 'users-form-grid'}}) }}
            <div class="form-row two" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;">
                <div class="form-group" style="display:grid;gap:6px;">
                    {{ form_label(form.prenom) }}
                    {{ form_widget(form.prenom, {attr: {class: 'custom-input'}}) }}
                    {{ form_errors(form.prenom) }}
                </div>

                <div class="form-group" style="display:grid;gap:6px;">
                    {{ form_label(form.nom) }}
                    {{ form_widget(form.nom, {attr: {class: 'custom-input'}}) }}
                    {{ form_errors(form.nom) }}
                </div>
            </div>

            <div class="form-row two" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:12px;">
                <div class="form-group" style="display:grid;gap:6px;">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email, {attr: {class: 'custom-input'}}) }}
                    {{ form_errors(form.email) }}
                </div>

                <div class="form-group" style="display:grid;gap:6px;">
                    {{ form_label(form.telephone) }}
                    {{ form_widget(form.telephone, {attr: {class: 'custom-input'}}) }}
                    {{ form_errors(form.telephone) }}
                </div>
            </div>

            <div class="form-group" style="display:grid;gap:6px;margin-top:12px;">
                {{ form_label(form.image) }}
                {{ form_widget(form.image, {attr: {class: 'custom-input'}}) }}
                {{ form_errors(form.image) }}
            </div>

            <div style="margin-top:16px;display:flex;justify-content:flex-end;">
                <button type="submit" class="primary-btn">Enregistrer les modifications</button>
            </div>
        {{ form_end(form) }}
    </section>

    <section id="favorite-places" class="app-card" style="padding:24px;margin-top:18px;">
        <div class="section-head" style="margin-bottom:14px;">
            <div>
                <h2 class="section-title" style="margin:0;">Mes lieux favoris</h2>
                <p class="section-subtitle" style="margin-top:6px;">Retrouve rapidement les lieux que tu as sauvegardes.</p>
            </div>
        </div>

        {% if favoritePlaces is empty %}
            <div style="padding:16px;border:1px dashed rgba(20,61,113,.18);border-radius:16px;background:rgba(255,255,255,.72);color:var(--ft-muted);">
                Aucun lieu favori pour le moment.
            </div>
        {% else %}
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;">
                {% for item in favoritePlaces %}
                    {% set favoriteRawImage = item.image_url|default('') %}
                    {% if favoriteRawImage and (favoriteRawImage starts with 'http://' or favoriteRawImage starts with 'https://') %}
                        {% set favoriteImageSrc = favoriteRawImage %}
                    {% elseif favoriteRawImage and (favoriteRawImage starts with 'theme/' or favoriteRawImage starts with 'uploads/') %}
                        {% set favoriteImageSrc = asset(favoriteRawImage) %}
                    {% elseif favoriteRawImage %}
                        {% set favoriteImageSrc = asset('uploads/lieux/' ~ favoriteRawImage) %}
                    {% else %}
                        {% set favoriteImageSrc = asset('theme/images/logo.png') %}
                    {% endif %}

                    <article style="display:grid;gap:12px;padding:14px;border:1px solid rgba(20,61,113,.1);border-radius:18px;background:linear-gradient(180deg,rgba(255,255,255,.96),rgba(244,249,255,.94));box-shadow:0 12px 28px rgba(12,45,94,.08);">
                        <img src="{{ favoriteImageSrc }}" alt="{{ item.nom }}" style="width:100%;height:150px;object-fit:cover;border-radius:14px;" onerror="this.onerror=null;this.src='{{ asset('theme/images/logo.png') }}';">
                        <div style="display:grid;gap:6px;">
                            <div style="font-size:1rem;font-weight:800;color:var(--ft-text);">{{ item.nom }}</div>
                            <div style="font-size:.86rem;color:var(--ft-muted);">{{ item.ville ?: 'Ville non renseignee' }}</div>
                            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                                {% if item.categorie %}
                                    <span style="padding:5px 10px;border-radius:999px;background:#fef3c7;color:#92400e;font-size:.75rem;font-weight:700;">{{ item.categorie|replace({'_':' '})|upper }}</span>
                                {% endif %}
                                {% if item.type %}
                                    <span style="padding:5px 10px;border-radius:999px;background:#e0e7ff;color:#3730a3;font-size:.75rem;font-weight:700;">{{ item.type|replace({'_':' '})|upper }}</span>
                                {% endif %}
                            </div>
                            <div style="font-size:.86rem;color:var(--ft-text);font-weight:700;">
                                {% if item.budget_min is not null or item.budget_max is not null %}
                                    Budget: {{ item.budget_min|default(0)|number_format(0, ',', ' ') }} - {{ item.budget_max|default(0)|number_format(0, ',', ' ') }} TND
                                {% else %}
                                    Budget non renseigne
                                {% endif %}
                            </div>
                        </div>
                        <a href="{{ path('app_lieu_show', {id: item.id}) }}" class="primary-btn" style="text-decoration:none;text-align:center;">Voir le lieu</a>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
